# bmg-capital-site — Caddyfile written by scripts/local/site_publish.py.
# Do not edit by hand. See site_publish.py for the per-class rationale.
:{$PORT:80} {
	root * .
	file_server

	@html {
		path *.html / */
	}
	header @html Cache-Control "no-cache"

	# Un-hashed stylesheet copies: byte-identical to the hashed name but
	# must revalidate so an old browser cache can never pin stale content.
	@legacy_css {
		path /site.css /house-style.css
	}
	header @legacy_css Cache-Control "no-cache"

	# Fingerprinted CSS (site.<hash>.css, house-style.<hash>.css): the
	# filename itself changes when content changes, so the response is
	# immutable at a given URL.
	@hashed_css {
		path_regexp hashed_css ^/(site|house-style)\.[0-9a-f]{8}\.css$
	}
	header @hashed_css Cache-Control "public, max-age=31536000, immutable"

	# Other hash-free CSS and all JS/images: immutable. Rebuilds that
	# change these files should change the filename (fingerprint).
	@static {
		path *.js *.png *.jpg *.jpeg *.svg *.webp *.gif *.ico *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Documents that rebuild in place without filename changes: must
	# revalidate so a new resume or model reaches recruiters.
	@docs {
		path *.pdf *.xlsx *.pptx *.docx
	}
	header @docs Cache-Control "no-cache"
}
